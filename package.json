{
  "name": "infra-lab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env --enable-source-maps packages/core/dist/migrate.js",
    "dev:api": "node --env-file-if-exists=.env --conditions=@infra-lab/source --watch apps/api/src/index.ts",
    "dev:worker": "node --env-file-if-exists=.env --conditions=@infra-lab/source --watch apps/worker/src/index.ts",
    "start:api": "node --env-file-if-exists=.env --enable-source-maps apps/api/dist/index.js",
    "start:worker": "node --env-file-if-exists=.env --enable-source-maps apps/worker/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
