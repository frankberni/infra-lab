# PostgreSQL connection string (matches the `docker run ... postgres:18` command in the README)
DATABASE_URL=postgres://infra_lab:infra_lab@localhost:5432/infra_lab

# Redis connection string (matches the `docker run ... redis:8` command in the README)
REDIS_URL=redis://localhost:6379

# HTTP port of the API (default 3000)
PORT=3000

# Pino log level: fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=info

# Jobs processed in parallel by each worker process, 1-100 (default 5)
WORKER_CONCURRENCY=5

# Simulated summarization latency in ms, 0-60000 (default 0): makes the `processing` state
# and the graceful drain of active jobs on SIGTERM observable
SUMMARIZER_DELAY_MS=1000
